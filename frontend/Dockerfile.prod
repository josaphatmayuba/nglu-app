FROM nginx:alpine
# Build context is the REPO ROOT (see docker-compose.prod.yml).
# CRM (admin SPA) — served under /crm -> /admin
COPY frontend/dist/ /usr/share/nginx/html
# Production marketing landing — baked into the image (no host bind mount).
COPY marketing-site/dist/ /usr/share/nginx/html-marketing-prod
# Production FarmOS SPA at /farmos/ — baked into the image.
COPY farmos-app/dist/ /usr/share/nginx/html-farmos-prod
# Production BatiPro / HR / Comptabilite SPAs.
COPY batipro-app/dist/ /usr/share/nginx/html-batipro-prod
COPY hr-app/dist/ /usr/share/nginx/html-hr-prod
COPY comptabilite-app/dist/ /usr/share/nginx/html-comptabilite-prod
# Domus SPA at /domus/ — baked as empty placeholder; pipeline overwrites via docker cp.
RUN mkdir -p /usr/share/nginx/html-domus-prod
# Chat SPA at /chat/
COPY chat-app/dist/ /usr/share/nginx/html-chat-prod
# nginx.conf is mounted from the host at runtime (see docker-compose.prod.yml)
EXPOSE 80
