  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "moderate": true,
  // react-router v7 corrige GHSA-337j / GHSA-wrjc ; quill GHSA-v3m3 (low) reste sous le seuil moderate.
  "allowlist": [
    // minimatch < 11.0.1 (GHSA-g3hv-75wg-m249, DoS sur motifs glob) : correctif seulement en v11 (API cassante pour eslint/glob v3-9).
