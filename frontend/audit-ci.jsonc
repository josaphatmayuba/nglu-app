    // glob 9-14.0.1 (GHSA-3g3m-2fjr-6pw4, contournement AbortSignal) : correctif en 14.0.2 seulement, tire par workbox/rimraf/jest.
    // Outillage de build/test sur nos propres dossiers, aucun motif ni signal venant d un utilisateur. A retirer apres montee des parents.
    "GHSA-3g3m-2fjr-6pw4"
  ]
