	"scripts": {
		"dev": "vite --port 3000 --host",
		"dev:local": "vite --port 3000 --host --mode development-local",
		"build": "node -e \"console.error('\\n[ERREUR] Utilisez npm run build:dev (dev) ou npm run build:prod (prod).\\nPlain build interdit — le bundle n\\'aurait aucune cible API garantie.\\n'); process.exit(1)\"",
