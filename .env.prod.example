# ──────────────────────────────────────────────────────────────────
# Production environment template
# Copy to /opt/nglu-app/.env.prod on the server and fill in real values
# Generate JWT_SECRET with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────

# Database (external DB server)
DB_HOST=35.169.124.49
DB_PORT=9306
DB_DATABASE=nglu_db
DB_USERNAME=nglu_user
DB_PASSWORD=CHANGE_ME_prod_db_password
DB_ROOT_PASSWORD=CHANGE_ME_prod_root_password

# URLs
CORS_ORIGIN=https://ongdngolu.org
APP_URL=https://ongdngolu.org
VITE_APP_API=https://ongdngolu.org/api
VITE_API_URL=https://ongdngolu.org/api
VITE_APP_API_NODE=https://ongdngolu.org/api

# Realtime Redis Pub/Sub
REDIS_ENABLED=true

# Mail / SMTP
SMTP_HOST=mail.ongdngolu.org
SMTP_PORT=587
SMTP_USER=noreply@ongdngolu.org
SMTP_PASS=CHANGE_ME_mailbox_password
SMTP_FROM=noreply@ongdngolu.org
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Mail / IMAP inbox sync
IMAP_HOST=mail.ongdngolu.org
IMAP_PORT=993
IMAP_USER=noreply@ongdngolu.org
IMAP_PASS=CHANGE_ME_mailbox_password
IMAP_MAILBOX=INBOX
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Stalwart account provisioning
STALWART_JMAP_URL=http://mail.ongdngolu.org:8088/jmap
STALWART_ADMIN_USER=admin@ongdngolu.org
STALWART_ADMIN_PASS=CHANGE_ME_admin_password
STALWART_DOMAIN=ongdngolu.org

# Secrets
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
