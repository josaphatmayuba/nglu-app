# ──────────────────────────────────────────────────────────────────
# Production environment template
# Copy to /opt/nglu-app/.env.prod on the server and fill in real values
# Generate secrets with: openssl rand -hex 32
# With Doppler: run scripts/sync-env-doppler.ps1 -Environment prod -DopplerToken <token>
# ──────────────────────────────────────────────────────────────────

# Database (external DB server)
DB_HOST=35.169.124.49
DB_PORT=9306
DB_DATABASE=nglu_db
DB_USERNAME=nglu_user
DB_PASSWORD=CHANGE_ME_prod_db_password
DB_ROOT_PASSWORD=CHANGE_ME_prod_root_password
DB_WAIT_RETRIES=40
DB_WAIT_DELAY_MS=1500

# URLs
CORS_ORIGIN=https://ongdngolu.org
APP_URL=https://ongdngolu.org
FRONTEND_URL=https://ongdngolu.org/crm
VITE_APP_API=https://ongdngolu.org/api
VITE_API_URL=https://ongdngolu.org/api
VITE_APP_API_NODE=https://ongdngolu.org/api

# Google Sign-In (same OAuth client id on frontend and backend verification)
GOOGLE_CLIENT_ID=CHANGE_ME_google_oauth_client_id
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_google_oauth_client_id

# Realtime Redis Pub/Sub
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
# Required: Redis runs with --requirepass ${REDIS_PASSWORD}. Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_CHANNEL_USER_UPDATES=permissions-updates
REDIS_CHANNEL_DATA_UPDATES=data-updates

# Keep at 0 so server-side permission revocations apply immediately.
PERMISSIONS_GUARD_CACHE_TTL_MS=0

# Mail / SMTP
SMTP_HOST=mail.ongdngolu.org
SMTP_PORT=587
SMTP_USER=noreply@ongdngolu.org
SMTP_PASS=CHANGE_ME_mailbox_password
SMTP_FROM=noreply@ongdngolu.org
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Mail / IMAP inbox sync
IMAP_HOST=mail.ongdngolu.org
IMAP_PORT=993
IMAP_USER=noreply@ongdngolu.org
IMAP_PASS=CHANGE_ME_mailbox_password
IMAP_MAILBOX=INBOX
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Stalwart account provisioning.
# Use an internal-only URL reachable by backend2. Never expose or use public http://mail.ongdngolu.org:8088/jmap.
STALWART_JMAP_URL=
STALWART_ADMIN_USER=
STALWART_ADMIN_PASS=
STALWART_DOMAIN=ongdngolu.org

# Twilio SMS
TWILIO_ACCOUNT_SID=CHANGE_ME_twilio_account_sid
TWILIO_AUTH_TOKEN=CHANGE_ME_twilio_auth_token
# Use either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_FROM=+10000000000
TWILIO_MESSAGING_SERVICE_SID=
# SMS Gateway for Android (telephone physique, remplace/complete Twilio)
SMS_GATEWAY_LOGIN=CHANGE_ME_sms_gateway_login
SMS_GATEWAY_PASSWORD=CHANGE_ME_sms_gateway_password
SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1

# Automatic overdue-rent reminders (SMS + email). Set to true to enable the daily job.
RENT_REMINDERS_ENABLED=false
RENT_REMINDER_OVERDUE_DAYS=15
RENT_REMINDER_CRON=0 9 * * *

# Appels audio du chat (WebRTC) — serveur TURN coturn.
# TURN_SECRET est partagé entre coturn et le backend : il sert à générer des
# credentials éphémères. Il ne doit jamais être envoyé aux clients.
TURN_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Hôte TURN public (DNS pointant vers le serveur, ou IP publique).
TURN_HOST=CHANGE_ME_turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=nglu.chat
TURN_CREDENTIAL_TTL=3600
# IP publique du serveur — OBLIGATOIRE en prod (VPS derrière NAT).
# Sans elle, coturn annonce son IP privée et tous les appels relayés échouent.
TURN_EXTERNAL_IP=CHANGE_ME_public_ip

# Secrets — rotate with: openssl rand -hex 32
# NEVER commit a .env file with real values to git.
# In production, inject via docker-compose environment section or Doppler.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
