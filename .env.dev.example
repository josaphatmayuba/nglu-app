# ──────────────────────────────────────────────────────────────────
# Dev environment template
# Copy to /opt/nglu-app-dev/.env.dev on the server and fill in real values
# Generate secrets with: openssl rand -hex 32
# With Doppler: run scripts/sync-env-doppler.ps1 -Environment dev -DopplerToken <token>
# ──────────────────────────────────────────────────────────────────

# Database (local MySQL container in dev stack)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nglu_db_dev
DB_USERNAME=nglu_user_dev
DB_PASSWORD=CHANGE_ME_dev_db_password
DB_ROOT_PASSWORD=CHANGE_ME_dev_root_password
DB_WAIT_RETRIES=40
DB_WAIT_DELAY_MS=1500

# URLs
CORS_ORIGIN=https://dev.ongdngolu.org
APP_URL=https://dev.ongdngolu.org
FRONTEND_URL=https://dev.ongdngolu.org/crm
VITE_APP_API=https://dev.ongdngolu.org/api
VITE_API_URL=https://dev.ongdngolu.org/api
VITE_APP_API_NODE=https://dev.ongdngolu.org/api

# Realtime Redis Pub/Sub
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CHANNEL_USER_UPDATES=permissions-updates
REDIS_CHANNEL_DATA_UPDATES=data-updates

# Keep at 0 so server-side permission revocations apply immediately.
PERMISSIONS_GUARD_CACHE_TTL_MS=0

# Mail / SMTP
SMTP_HOST=mail.ongdngolu.org
SMTP_PORT=587
SMTP_USER=noreply@ongdngolu.org
SMTP_PASS=CHANGE_ME_mailbox_password
SMTP_FROM=noreply@ongdngolu.org
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Mail / IMAP inbox sync
IMAP_HOST=mail.ongdngolu.org
IMAP_PORT=993
IMAP_USER=noreply@ongdngolu.org
IMAP_PASS=CHANGE_ME_mailbox_password
IMAP_MAILBOX=INBOX
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Stalwart account provisioning
STALWART_JMAP_URL=http://mail.ongdngolu.org:8088/jmap
STALWART_ADMIN_USER=admin@ongdngolu.org
STALWART_ADMIN_PASS=CHANGE_ME_admin_password
STALWART_DOMAIN=ongdngolu.org

# Twilio SMS
TWILIO_ACCOUNT_SID=CHANGE_ME_twilio_account_sid
TWILIO_AUTH_TOKEN=CHANGE_ME_twilio_auth_token
# Use either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_FROM=+10000000000
TWILIO_MESSAGING_SERVICE_SID=

# Secrets — rotate with: openssl rand -hex 32
# NEVER commit a .env file with real values to git.
# In dev, inject via docker-compose environment section or Doppler.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
