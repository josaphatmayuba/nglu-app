{
  "name": "comptabilite-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"console.error('\\n[ERREUR] Utilisez npm run build:dev (dev) ou npm run build:prod (prod).\\nPlain build interdit: cible API non garantie.\\n'); process.exit(1)\"",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "vite preview --host 0.0.0.0",
    "build:avelomi": "vite build --mode avelomi --outDir dist-avelomi"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
