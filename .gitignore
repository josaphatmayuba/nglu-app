# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
dist-dev/
dist-prod/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# ── Environment files (NEVER commit real secrets) ───────────
# Ignore all live env files
.env
.env.*
.env.local
.env.prod
.env.dev
backend/.env
backend/.env.*
backend2/.env
backend2/.env.*
backend2/.env.local
middleware/.env
middleware/.env.*
middleware/.env.local
frontend/.env
frontend/.env.*
frontend/.env.local

# But keep committed templates
!.env.example
!.env.prod.example
!.env.dev.example
!frontend/.env.production
!frontend/.env.development
!backend2/.env.example
!mail/stalwart/.env.example

# Local Claude settings
.claude/

# Backend2 storage
backend2/storage/
Userspaulnjira.json

# Inventaire animaux (fichier de travail local)
farmos_inventaire_animaux_reorganise.csv
