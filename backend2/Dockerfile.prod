FROM node:20-alpine

# Chromium pour la génération PDF puppeteer (HR + FarmOS).
# IMPORTANT : bloc NON bloquant. L'install peut échouer (OOM sur petite
# instance, ~750 Mio / 206 paquets) sans casser le build/déploiement — sinon
# tout le backend ne déploie plus. Si chromium est présent on crée le symlink ;
# sinon le service PDF échoue proprement au runtime (le reste du backend tourne).
# `|| true` + `set +e` garantissent exit 0 quelle que soit l'issue de l'apk.
RUN set +e; \
    apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont || echo "WARN: apk chromium a échoué (PDF indisponible jusqu'au prochain build avec assez de RAM)"; \
    CHROME_BIN="$(command -v chromium-browser || command -v chromium || true)"; \
    if [ -n "$CHROME_BIN" ] && [ "$CHROME_BIN" != "/usr/bin/chromium" ]; then ln -sf "$CHROME_BIN" /usr/bin/chromium; fi; \
    if [ -x /usr/bin/chromium ] || [ -n "$CHROME_BIN" ]; then echo "chromium OK: ${CHROME_BIN:-/usr/bin/chromium}"; else echo "WARN: chromium absent de l'image"; fi; \
    exit 0

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY dist/ ./dist/
COPY drizzle/ ./drizzle/
EXPOSE 8001
CMD ["npm", "run", "docker:prod"]
