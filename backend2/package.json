{
  "name": "nglu-backend2",
  "version": "3.79.8",
  "private": true,
  "overrides": {
    "qs": "^6.15.2",
    "lodash": "^4.18.1",
    "multer": "^2.1.1",
    "esbuild": "^0.28.1"
  },
  "description": "Second NestJS backend for NgluERP progressive API migration.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:wait": "ts-node -r tsconfig-paths/register src/database/wait-for-db.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:seed:demo": "ts-node -r tsconfig-paths/register src/database/seed-demo.ts",
    "db:migrate:run": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "docker:dev": "npm run db:wait && npm run db:migrate:run && (npm run db:seed || true) && (npm run db:seed:demo || true) && npm run dev",
    "docker:prod": "node dist/src/database/wait-for-db.js && node dist/src/database/migrate.js && node dist/src/main.js",
    "docker:dev-deployed": "node dist/src/database/wait-for-db.js && node dist/src/database/migrate.js && (node dist/src/database/seed.js || true) && (node dist/src/database/seed-demo.js || true) && node dist/src/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/testing": "^11.1.24",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "@types/cookie-parser": "^1.4.10",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.1.0",
    "imapflow": "^1.3.3",
    "ioredis": "^5.10.1",
    "libphonenumber-js": "^1.13.4",
    "mailparser": "^3.9.8",
    "mysql2": "^3.11.5",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "world-currencies": "^0.0.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
