{
  "name": "nglu-backend2",
  "version": "0.1.0",
  "private": true,
  "description": "Second NestJS backend for NgluERP progressive API migration.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:wait": "ts-node -r tsconfig-paths/register src/database/wait-for-db.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:seed:demo": "ts-node -r tsconfig-paths/register src/database/seed-demo.ts",
    "db:migrate:run": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "docker:dev": "npm run db:wait && npm run db:migrate:run && npm run db:seed && npm run db:seed:demo && npm run dev",
    "docker:prod": "node dist/src/database/wait-for-db.js && node dist/src/database/migrate.js && node dist/src/main.js",
    "docker:dev-deployed": "node dist/src/database/wait-for-db.js && node dist/src/database/migrate.js && (node dist/src/database/seed.js || true) && (node dist/src/database/seed-demo.js || true) && node dist/src/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "helmet": "^8.1.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "world-currencies": "^0.0.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.30.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
