NODE_ENV=development
PORT=8001

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nglu_db
DB_USERNAME=nglu_user
DB_PASSWORD=password
DB_WAIT_RETRIES=40
DB_WAIT_DELAY_MS=1500

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CHANNEL_USER_UPDATES=permissions-updates
REDIS_CHANNEL_DATA_UPDATES=data-updates

# Keep at 0 so server-side permission revocations apply immediately.
PERMISSIONS_GUARD_CACHE_TTL_MS=0

SMTP_HOST=mail.ongdngolu.org
SMTP_PORT=587
SMTP_USER=noreply@ongdngolu.org
SMTP_PASS=CHANGE_ME_mailbox_password
SMTP_FROM=noreply@ongdngolu.org
SMTP_TLS_REJECT_UNAUTHORIZED=true

IMAP_HOST=mail.ongdngolu.org
IMAP_PORT=993
IMAP_USER=noreply@ongdngolu.org
IMAP_PASS=CHANGE_ME_mailbox_password
IMAP_MAILBOX=INBOX
IMAP_TLS_REJECT_UNAUTHORIZED=true

STALWART_JMAP_URL=http://mail.ongdngolu.org:8088/jmap
STALWART_ADMIN_USER=admin@ongdngolu.org
STALWART_ADMIN_PASS=CHANGE_ME_admin_password
STALWART_DOMAIN=ongdngolu.org

TWILIO_ACCOUNT_SID=CHANGE_ME_twilio_account_sid
TWILIO_AUTH_TOKEN=CHANGE_ME_twilio_auth_token
# Use either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_FROM=+10000000000
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# Secrets management (P3-3)
# ---------------------------------------------------------------------------
# NEVER commit a .env file containing real secrets to git.
# In production, inject secrets as environment variables via docker-compose
# environment section or your hosting panel — never copy a .env file to the
# server. Rotate secrets by updating the env var and restarting the container.
#
# Critical secrets to rotate immediately on compromise:
#   JWT_SECRET, REFRESH_SECRET, DB_PASSWORD, SMTP_PASS, REDIS_PASSWORD
#
# Recommended rotation procedure (no AWS needed):
#   1. Generate a new value: openssl rand -hex 32
#   2. Update the variable in your docker-compose .env or hosting panel.
#   3. Restart the backend container: docker compose restart backend2
#   4. For JWT_SECRET, all active sessions are invalidated on restart —
#      users must log in again.
# ---------------------------------------------------------------------------
